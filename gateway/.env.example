DATABASE_URL=postgresql://localhost/common_network

# Referenced by name (never the raw key) from nodes.api_key_ref, e.g. OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# --- Routing (v0.1) ------------------------------------------------------
W_SIM=0.7
W_COST=0.15
W_LAT=0.15
REGION_BONUS=0.05
W_TAG_OVERLAP=0.15

# Below this *topical* score (similarity + tag overlap, excluding cost and
# latency), prefer a confident generalist over a low-confidence specialist.
ROUTING_CONFIDENCE_THRESHOLD=0.40

# --- Composition (v0.1.1) ------------------------------------------------

# auto   — compose only where the preconditions hold (see testing/seam-findings.md).
# never  — v0.1 behaviour exactly. Also the control arm for any A/B.
# always — compose wherever two different nodes lead two different domains.
#          For experiments. The domination gate still applies: composing a node
#          with one it dominates was measured to lose, so no setting enables it.
COMPOSE_MODE=auto

# How relevance is decided. NOT an absolute similarity threshold: measured
# against BAAI/bge-small-en-v1.5, cosine between a request and a short domain
# tag sits at 0.42-0.64 for everything -- "write me a poem about the sea"
# scores 0.553 on `math`, above a real arithmetic question's 0.537 -- so no
# absolute floor separates on-topic from off-topic. Instead the gateway ranks
# domains and looks for a drop-off (an elbow) in the top few positions.
# Off-topic requests produce an early gap of 0.026-0.038; a genuinely on-topic
# one produced 0.172. Re-derive with `python tests/calibrate_gate.py` if you
# change the embedding model.
COMPOSE_DOMAIN_GAP=0.05
COMPOSE_DOMAIN_MIN_TAGS_FOR_RELATIVE=4

# The embedder reliably finds the ONE domain a request is about and reliably
# does NOT find a second (the rank-2 to rank-3 gap is 0.010-0.038 whether or
# not the request really spans two). So the second lane comes from a
# deterministic check: does the request ask for a calculation? These tags are
# the lane seated when it does. This is why a legal question with money in it
# composes and a poem does not.
COMPOSE_QUANTITATIVE_TAGS=math,arithmetic,quantitative,calculation,word-problems,maths

# Sanity floor only -- rejects domains unrelated on any reading. The
# discrimination is done by the elbow above.
COMPOSE_DOMAIN_FLOOR=0.30

# Domains a request must span before composing is worth it. Below this, one
# specialist covers the request and a panel adds cost without coverage.
COMPOSE_MIN_DOMAINS=2

# Ceiling on panel size. Every member is a full inference on someone's donated
# laptop.
COMPOSE_MAX_PANEL=3

# A panel member that hasn't answered by now is dropped and the rest proceed —
# a degraded answer beats a timed-out one. Deliberately generous: a cold 7B
# model on a 16GB laptop can take ~57s.
COMPOSE_MEMBER_TIMEOUT_SECONDS=90

# Tags describing breadth rather than a lane, which can never earn a panel
# seat. Without this a generalist matches everything moderately well, `general`
# clears the floor on almost every request, and the gateway seats a generalist
# beside a specialist in that specialist's own domain — the pairing that lost
# in seam-findings.md §2. Generalists still aggregate.
COMPOSE_EXCLUDED_DOMAINS=general,conversation,chat,assistant,instruction-following

# --- Health and forwarding ----------------------------------------------
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=5
FORWARD_TIMEOUT_SECONDS=60

# --- Seeding -------------------------------------------------------------
SEED_FILE=nodes.seed.yaml
SEED_ON_STARTUP=true

# Local dev runs uvicorn from gateway/, where catalogue/ is a sibling. The
# Docker image copies catalogue/ in as a child of /app instead — Railway sets
# CATALOGUE_SEED_FILE=catalogue/catalogue.seed.yaml to override this.
CATALOGUE_SEED_FILE=../catalogue/catalogue.seed.yaml
CATALOGUE_SEED_ON_STARTUP=true

# Only assign a catalogue model if it leaves this much RAM headroom — a
# specialist that swaps and times out is worse than a generalist that answers.
ASSIGNMENT_RAM_HEADROOM=0.8
